# SuperAgenticMCP environment example
# Copy to .env and fill values as needed. Never commit real secrets.

# Router
SUPERAGENTIC_PORT=7420
SUPERAGENTIC_BOARD=true
SUPERAGENTIC_CALL_BUDGET=40

# Optional model / provider keys (only if bandit routing is enabled)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# Optional downstream MCP server credentials
# SEARCH_API_KEY=
# GITHUB_TOKEN=
# DATABASE_URL=
# SLACK_TOKEN=
